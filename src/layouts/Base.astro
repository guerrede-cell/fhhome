---
// Shared header + footer for the blog pages, copied from the Webflow export
// so they look identical to the rest of the site.
interface Props {
  title: string;
  description?: string;
  image?: string;
  wfPage: string;
  nav?: 'blog' | 'post';
  jsonLd?: object;
}
const { title, description, image, wfPage, nav = 'blog', jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const current = Astro.url.pathname.startsWith('/blog') ? 'blog' : '';

const business = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: 'FH Home Improvements',
  description:
    'FH Home Improvements offers professional kitchen and bathroom remodeling services in Summit, New Jersey. Serving the community for over 15 years.',
  url: 'https://fhhomeimprovements.com',
  telephone: '+1-908-361-0395',
  email: 'adbuilder123@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '34 Kent Pl Blvd',
    addressLocality: 'Summit',
    addressRegion: 'NJ',
    postalCode: '07901',
    addressCountry: 'US',
  },
  hasMap: 'https://maps.app.goo.gl/SdK7XMqnmCNM8SVN7',
  openingHours: ['Mo-Sa 07:00-19:00'],
  foundingDate: '2010',
  areaServed: { '@type': 'Place', name: 'Summit, New Jersey' },
};
---
<!DOCTYPE html>
<html data-wf-page={wfPage} data-wf-site="67808674b0157860f271afb4" lang="en">
<head>
  <meta charset="utf-8">
  <title>{title}</title>
  {description && <meta content={description} name="description">}
  <meta content={title} property="og:title">
  {description && <meta content={description} property="og:description">}
  {ogImage && <meta content={ogImage} property="og:image">}
  <meta content={title} name="twitter:title">
  {description && <meta content={description} name="twitter:description">}
  {ogImage && <meta content={ogImage} name="twitter:image">}
  <meta property="og:type" content="website">
  <meta content="summary_large_image" name="twitter:card">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <link rel="canonical" href={canonical}>
  <link href="/css/normalize.css" rel="stylesheet" type="text/css">
  <link href="/css/webflow.css" rel="stylesheet" type="text/css">
  <link href="/css/fh-home-improvements.webflow.css" rel="stylesheet" type="text/css">
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous">
  <script is:inline src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js" type="text/javascript"></script>
  <script is:inline type="text/javascript">WebFont.load({  google: {    families: ["Barlow:300,400,500,600,700"]  }});</script>
  <script is:inline type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
  <link href="/images/favicon.png" rel="shortcut icon" type="image/x-icon">
  <link href="/images/webclip.png" rel="apple-touch-icon">
  <meta name="google-site-verification" content="mvXeQD7rx5eEVo8WqKnXl7rNPg5T5wVZ5X6aLl82ppg">
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <script type="application/ld+json" set:html={JSON.stringify(business)} />
</head>
<body>
  {nav === 'blog' ? (
    <div data-animation="over-left" data-collapse="medium" data-duration="400" data-easing="ease-in" data-easing2="ease-in-out" role="banner" class="navbar blognavbar w-nav">
      <div class="mycontain1280">
        <a href="/" class="w-nav-brand"><img src="/images/FH-HOME---LOGO--2x.avif" loading="lazy" width="237" alt="FH Home Improvements"></a>
        <nav role="navigation" class="nav-menu w-nav-menu">
          <a href="/" class="navlink w-nav-link">Home</a>
          <a href="/about-us" class="navlink w-nav-link">About Us</a>
          <a href="/testimonial" class="navlink w-nav-link">Testimonials </a>
          <div data-hover="true" data-delay="0" class="dropdown w-dropdown">
            <div class="dropdown-toggle w-dropdown-toggle">
              <div class="icon w-icon-dropdown-toggle"></div>
              <div class="text-block-19">Services</div>
            </div>
            <nav class="w-dropdown-list">
              <a href="/kitchen-remodel-new-jersey" class="dropdown-link w-dropdown-link">Kitchen Remodel </a>
              <a href="/bathroom-renovation-new-jersey" class="dropdown-link w-dropdown-link">Bathroom Remodel </a>
              <a href="/carpentry-new-jersey" class="dropdown-link w-dropdown-link">Carpentry Remodel </a>
              <a href="/home-remodel-new-jersey" class="dropdown-link w-dropdown-link">Home Remodel</a>
              <a href="/interior-painting-summit-nj" class="dropdown-link w-dropdown-link">Interior Painting </a>
            </nav>
          </div>
          <a href="/contact-us" class="navlink w-nav-link">Contact Us</a>
          <a href="/blog" aria-current={current === 'blog' ? 'page' : undefined} class:list={['navlink w-nav-link', { 'w--current': current === 'blog' }]}>Blog</a>
          <div class="div-block-47">
            <a href="/contact-us" class="getaquotebutton w-button">Get a Quote </a>
            <a href="tel:9083610395" class="getaquotebutton w-button">908-361-0395</a>
          </div>
        </nav>
        <div class="menu-button w-nav-button">
          <div class="w-icon-nav-menu"></div>
        </div>
      </div>
    </div>
  ) : (
    <div data-animation="over-left" data-collapse="medium" data-duration="400" data-easing="ease" data-easing2="ease" role="banner" class="navbar contactnav w-nav">
      <div class="mycontain1280">
        <a href="/" class="brand w-nav-brand"><img src="/images/FH-HOME---LOGO--2x.avif" loading="lazy" width="190" alt="FH Home Improvements" class="image-7"></a>
        <nav role="navigation" class="nav-menu contactmenu w-nav-menu">
          <a href="/" class="navlink maroonlink w-nav-link">Home</a>
          <a href="/about-us" class="navlink maroonlink w-nav-link">About Us</a>
          <a href="/testimonial" class="navlink maroonlink w-nav-link">Testimonials </a>
          <div data-hover="true" data-delay="0" class="w-dropdown">
            <div class="dropdown-toggle-2 w-dropdown-toggle">
              <div class="text-block-24">Services</div>
            </div>
            <nav class="dropdown-list w-dropdown-list">
              <a href="/kitchen-remodel-new-jersey" class="contactnavlink w-dropdown-link">Kitchen Remodel</a>
              <a href="/bathroom-renovation-new-jersey" class="contactnavlink w-dropdown-link">Bathroom Remodel</a>
              <a href="/carpentry-new-jersey" class="contactnavlink w-dropdown-link">Carpentry Remodel </a>
              <a href="/home-remodel-new-jersey" class="contactnavlink w-dropdown-link">Home Remodel </a>
              <a href="/interior-painting-summit-nj" class="contactnavlink w-dropdown-link">Interior Painting </a>
            </nav>
          </div>
          <a href="/contact-us" class="navlink maroonlink w-nav-link">Contact Us</a>
          <a href="/blog" class="navlink maroonlink w-nav-link">Blog</a>
          <div class="div-block-49">
            <a href="/contact-us" class="getaquotebutton w-button">Get a Quote </a>
            <a href="tel:9083610395" class="getaquotebutton w-button">908-361-0395</a>
          </div>
        </nav>
        <div class="menu-button-3 w-nav-button">
          <div class="icon-2 w-icon-nav-menu"></div>
        </div>
      </div>
    </div>
  )}

  <slot />

  <section class="footer_section">
    <div class="mycontain1280">
      <div class="div-block-17">
        <div class="w-layout-grid footsection">
          <div>
            <a href="/" class="w-inline-block"><img src="/images/foot1.png" loading="lazy" width="378" sizes="(max-width: 479px) 100vw, (max-width: 991px) 49vw, 378px" alt="FH Home Improvements" srcset="/images/foot1-p-500.png 500w, /images/foot1.png 756w" class="image-2"></a>
            <div class="div-block-19">
              <div class="business_style">Business Hours<br>Monday-Friday:<br>9:00 AM - 5:00 PM <br><br>Saturday: By Appointment <br>Sunday: Closed</div>
            </div>
          </div>
          <div class="div-block-18">
            <div class="footer_title">Company </div>
            <div class="footer_side">
              <a href="/" class="footer_links">Home</a>
              <a href="/about-us" class="footer_links">About Us</a>
              <a href="/testimonial" class="footer_links">Testimonials </a>
              <a href="/contact-us" class="footer_links">Contact Us</a>
              <a href="/blog" class="footer_links">Blog</a>
            </div>
          </div>
          <div class="div-block-18">
            <div class="footer_title">Services</div>
            <div class="footer_side">
              <a href="/kitchen-remodel-new-jersey" class="footer_links">Kitchen Remodel </a>
              <a href="/bathroom-renovation-new-jersey" class="footer_links">Bathroom Remodel </a>
              <a href="/carpentry-new-jersey" class="footer_links">Carpentry Remodel </a>
              <a href="/home-remodel-new-jersey" class="footer_links">Complete Home Remodel </a>
              <a href="/interior-painting-summit-nj" class="footer_links">Interior Painting</a>
            </div>
          </div>
          <div class="div-block-18">
            <div class="footer_title">Contact Us</div>
            <div class="footer_side">
              <a href="mailto:adbuilder123@gmail.com?subject=New%20Project" class="footer_links">adbuilder123@gmail.com</a>
              <a href="tel:9083610395" class="footer_links">908-361-0395</a>
              <a href="#" class="footer_links">Summit, New Jersey </a>
            </div>
          </div>
        </div>
      </div>
      <div class="socialmedia_wrapper">
        <div class="div-block-20">
          <a href="https://www.instagram.com/fhhomeimprovements/" target="_blank" class="w-inline-block"><img src="/images/6929237_instagram_icon-2.svg" loading="lazy" alt="Instagram"></a>
          <div class="div-block-21">
            <a href="https://www.facebook.com/people/FH-HOME-Improvements/100064105929298/#" target="_blank" class="w-inline-block"><img src="/images/fb.svg" loading="lazy" alt="Facebook"></a>
          </div>
          <div class="div-block-21">
            <a href="https://x.com/fhhomesummitnj" class="w-inline-block"><img src="/images/twiiter.svg" loading="lazy" alt="X"></a>
          </div>
        </div>
      </div>
      <div class="div-block-59">
        <a href="https://www.dendigital.co/" target="_blank" class="link">Designed by <span class="text-span">DenDigital.co</span></a>
      </div>
    </div>
  </section>
  <script is:inline src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=67808674b0157860f271afb4" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script is:inline src="/js/webflow.js" type="text/javascript"></script>
</body>
</html>
